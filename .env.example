# FastAPI Application Settings
FASTAPI_TITLE=Handmade Shop API
FASTAPI_VERSION=1.0.0
DEBUG=False

# Database Configuration
# For SQLite: sqlite+aiosqlite:////app/data/shop.db
# For PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/shopdb
DATABASE_URL=sqlite+aiosqlite:////app/data/shop.db

# CORS Settings
# Comma-separated list of allowed origins, use "*" for any origin (not recommended for production)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8000

# Media Files Configuration
MEDIA_ROOT=/app/media
MEDIA_URL=/media

# Security (for future use)
# SECRET_KEY=your-secret-key-here
# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=30

# Telegram Bot Settings (for future integration)
# TELEGRAM_BOT_TOKEN=your-bot-token
# TELEGRAM_WEBHOOK_URL=https://your-domain.com/webhook/telegram

# Telegram Group for Admin Access Control
# ID группы, в которой бот является администратором. Только администраторы этой группы получат доступ к API/docs/admin
# TELEGRAM_ADMIN_GROUP_ID=-1001234567890

# Fallback: статический список администраторов (используется если TELEGRAM_BOT_TOKEN или TELEGRAM_ADMIN_GROUP_ID не заданы)
# ADMIN_TELEGRAM_IDS=123456789,987654321

# Admin Settings (for future use)
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD_HASH=hashed-password
